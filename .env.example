# Auth
APP_USERNAME=subidh
APP_PASSWORD=change-me
JWT_SECRET=change-me-generate-a-random-string

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key: RLS is enabled with no policies (see supabase/schema.sql).
# Backend-only — never expose this to the browser.
SUPABASE_KEY=your-supabase-service-role-key

# LLM
GROQ_API_KEY=your-groq-api-key

# Optional scrapers
WELLFOUND_SESSION=
WELLFOUND_CF=
WELLFOUND_DATADOME=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS (for production deployment)
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=
